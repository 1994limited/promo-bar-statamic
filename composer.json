{
    "name": "1994/promo-bar-statamic",
    "description": "Promo bars for Statamic: scheduled, targeted announcement bars with call-to-action buttons, countdowns, discount codes and Cargo free-delivery progress, styled in the Control Panel and safe behind static caching.",
    "type": "statamic-addon",
    "license": "proprietary",
    "keywords": [
        "statamic",
        "statamic-addon",
        "promo bar",
        "announcement bar",
        "banner",
        "countdown",
        "cargo"
    ],
    "authors": [
        {
            "name": "1994",
            "email": "hello@1994.co.uk",
            "homepage": "https://1994.co.uk"
        }
    ],
    "support": {
        "email": "hello@1994.co.uk"
    },
    "autoload": {
        "psr-4": {
            "NineteenNinetyFour\\PromoBar\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NineteenNinetyFour\\PromoBar\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.35"
    },
    "require-dev": {
        "duncanmcclean/statamic-cargo": "^1.15",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "duncanmcclean/statamic-cargo": "Shows how far the basket is from free delivery, and discount codes from Cargo's discounts (Cargo ^1.15)."
    },
    "conflict": {
        "duncanmcclean/statamic-cargo": "<1.15"
    },
    "extra": {
        "statamic": {
            "name": "Promo Bar",
            "description": "Scheduled, targeted promo bars with buttons, countdowns, discount codes and free-delivery progress. Styled in the Control Panel, safe behind static caching.",
            "developer": "1994",
            "developer-url": "https://1994.co.uk"
        },
        "laravel": {
            "providers": [
                "NineteenNinetyFour\\PromoBar\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
